# /etc/geminicode/env にコピーして値を入れる（chmod 600, 所有者 root）
# systemd の EnvironmentFile= として読み込まれる。値をクォートで囲まないこと。

# Gemini の認証方法
#   api-key : GEMINI_API_KEY を使う。課金を有効にしていないキーは無料枠（1 日 250 回程度）。
#   google  : Google アカウントでログイン（deploy/login-google.sh）。
#             2026-06-18 以降、個人向け（無料・Google AI Pro・Ultra）のアカウントは Gemini CLI で
#             使えなくなった。使えるのは Gemini Code Assist Standard / Enterprise の契約だけ。
GEMINICODE_AUTH=api-key

# Gemini API キー（GEMINICODE_AUTH=api-key のときだけ必要。https://aistudio.google.com/apikey）
GEMINI_API_KEY=

# GitHub の fine-grained personal access token
#   Repository access: 使うリポジトリだけを選択
#   Permissions: Contents (Read and write), Pull requests (Read and write), Metadata (Read)
GITHUB_TOKEN=

# Cloudflare Access（Zero Trust ダッシュボードで確認）
#   チームドメイン: Settings > Custom Pages などに表示される <team>.cloudflareaccess.com
#   AUD: Access > Applications > 対象アプリ > Overview の "Application Audience (AUD) Tag"
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
# Access のポリシーに加えて、ゲートウェイ側でも許可するメールアドレスを絞る（カンマ区切り）
ALLOWED_EMAILS=

# コミットの作者（GitHub の noreply アドレス推奨: Settings > Emails で確認）
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# 以下は任意
# GEMINICODE_PORT=8080
# GEMINICODE_DATA_DIR=/home/<user>/.local/share/geminicode
# 1日あたりのトークン上限（0 = 無制限）。超えると新しい指示を受け付けない
# GEMINICODE_DAILY_TOKEN_LIMIT=2000000
# 指示が無いまま何分たったら Gemini CLI のプロセスを止めるか（再開は自動）
# GEMINICODE_IDLE_MINUTES=30
# GEMINI_BIN=/usr/bin/gemini
# 新規セッションで最初に選ばれているモデル（画面で変更でき、前回の選択も記憶される）。
# 既定の auto は Pro 系を選ぶことが多く、混雑すると 503 で長くリトライする。Flash 系が安定。
# GEMINICODE_DEFAULT_MODEL=gemini-3-flash-preview
# Gemini CLI が起動してセッションを作るまでの待ち時間の上限（秒）
# GEMINICODE_STARTUP_TIMEOUT_SECONDS=120
# GeminiCode から起動する Gemini CLI の設定フォルダ（既定: <データフォルダ>/gemini-home）。
# 対話で使う ~/.gemini とは分けてあり、認証は常に API キーになる。
# GEMINICODE_GEMINI_HOME=
